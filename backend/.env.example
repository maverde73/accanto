# Copy to .env and adjust. Never commit the real .env.

ACCANTO_ENVIRONMENT=development
ACCANTO_DEBUG=true

# Async DSN (asyncpg driver)
ACCANTO_DATABASE_URL=postgresql+asyncpg://accanto:accanto@localhost:5432/accanto

# At least 32 characters (RFC 7518 §3.2). Startup refuses this dev value when
# ACCANTO_ENVIRONMENT=production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCANTO_JWT_SECRET=dev-only-insecure-secret-change-me-before-production
ACCANTO_ACCESS_TOKEN_TTL_SECONDS=900

# Comma-separated explicit origins. Wildcards are rejected in production.
ACCANTO_CORS_ORIGINS=http://localhost:3000

# Path to the Firebase service-account JSON used to push commands to collectors.
# ACCANTO_FCM_CREDENTIALS_PATH=/run/secrets/fcm.json
