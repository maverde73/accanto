<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location. Background access is requested separately and later: on
         Android 11+ it cannot be granted in the same dialog as the others. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Movement, from the phone's own hardware counters. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- The foreground service is the heart of the collector: without it One UI
         suspends the app and the pipeline goes quiet with no error anywhere. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Rung 5, two-way audio. The platform shows an indicator whenever the
         microphone is live and there is no hiding it; the design says so out
         loud beforehand rather than pretending otherwise. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Whether the watch is within Bluetooth range of the phone. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Rung 2: launching Mi Fitness from the background to force a sync.
         Android blocks background activity starts, but grants a documented
         exemption to apps holding this permission. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Rung 4: a full-screen "are you all right?" that cannot be missed. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Rung 4 fallback: raising the ringer when Do Not Disturb is active.
         Normally unnecessary, since the alarm stream already bypasses silent. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Detecting when the phone was last actually used: the strongest and
         cheapest liveness signal there is. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Health Connect: read-only, and only what the presence model actually
         consumes. Sleep is deliberately absent, because asking for it would be
         a permission the subject grants for nothing. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <queries>
        <!-- Mi Fitness, so the collector can launch it to force a sync. -->
        <package android:name="com.xiaomi.wearable" />
    </queries>

    <application
        android:name=".AccantoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Accanto">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect refuses to show its permission dialog unless the app
             can explain why it wants the data. A good requirement: health data
             is asked for far too casually. -->
        <activity
            android:name=".ui.PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Rung 4. Shown over the lock screen: a question that waits for
             someone to unlock their phone is not an answer to "is she well". -->
        <activity
            android:name=".ui.ConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Accanto" />

        <!-- Both types are required. `health` is what the service is for, but
             it also requests location updates while in the background, and
             Android 14+ refuses that without the `location` type declared. -->
        <service
            android:name=".collect.CollectorService"
            android:exported="false"
            android:foregroundServiceType="health|location" />

        <!-- Answers a rung-3 nudge in one tap, without opening anything. -->
        <receiver
            android:name=".collect.ResponseReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="info.maurizioverde.accanto.NOTIFICATION_REPLY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".collect.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
