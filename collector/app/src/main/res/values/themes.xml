<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose supplies the real theming; this only sets the window before the
         first frame, so the app does not flash a default background. -->
    <style name="Theme.Accanto" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
