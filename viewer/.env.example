# Copy to .env.local. Never commit the real file.

# Where the FastAPI backend lives. Server-side only: the browser never talks to
# it directly, so this value is not exposed to the client bundle.
ACCANTO_API_URL=http://localhost:8000

# Set to 1 in production so the session cookie carries the Secure flag.
# Left off in development because localhost is plain HTTP.
ACCANTO_SECURE_COOKIES=0
